# ============================================================
# SynapVault AI - Local Development Environment Example
# ============================================================
# Copy this file to .env before starting Docker.
# Never commit the real .env file.

# Project
COMPOSE_PROJECT_NAME=synapvault
APP_ENV=development

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=synapvault
POSTGRES_USER=synapvault_user
POSTGRES_PASSWORD=change_this_local_postgres_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_local_redis_password

# Qdrant
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=change_this_local_qdrant_key

# MinIO
MINIO_HOST=minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=synapvault_admin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_DEFAULT_BUCKET=synapvault-documents

# Local application URLs
WEB_URL=http://localhost:3000
SERVER_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000
